{
  "name": "@kokoro/contract-tooling",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "buf:breaking": "buf breaking",
    "buf:format": "buf format -w",
    "buf:format:check": "buf format --diff --exit-code",
    "buf:lint": "buf lint",
    "buf:generate": "node generate.mjs",
    "openapi:generate:public": "node generate-public-openapi.mjs",
    "openapi:generate:asset-data-plane": "node generate-public-openapi.mjs --schema asset-data-plane-v1",
    "openapi:lint": "redocly lint --extends=spec openapi/platform-public-v1.yaml openapi/asset-data-plane-v1.yaml openapi/admin-web-v1.yaml"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.41.0",
    "typescript": "5.9.3"
  }
}
