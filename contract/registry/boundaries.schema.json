{
  "$defs": {
    "boundary": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "description": "Who ultimately reaches this boundary. Two boundaries must not offer one consumer the same operation over different transports.",
          "minLength": 1,
          "type": "string"
        },
        "consumers": {
          "items": {
            "$ref": "#/$defs/party"
          },
          "minItems": 1,
          "type": "array"
        },
        "deadlineMs": {
          "description": "null means no deadline is declared in code yet; it is a recorded gap, not an implied default.",
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureOwner": {
          "description": "Repository paged when this boundary breaks.",
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "description": "Must match a contract id in config/repository/compatibility-matrix.json.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "lifecycle": {
          "description": "active: a provider implements this boundary and it is listed in the compatibility matrix. contract-only: the shape is published but no provider exists yet, so it is deliberately absent from the matrix that drives the runtime gate.",
          "enum": [
            "active",
            "contract-only"
          ],
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/operation"
          },
          "minItems": 1,
          "type": "array"
        },
        "protocol": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/party"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "sourceStatus": {
          "$ref": "#/$defs/sourceStatus"
        },
        "sources": {
          "description": "Must be non-empty when sourceStatus is machine-readable, and empty when it is declared-only.",
          "items": {
            "$ref": "#/$defs/source"
          },
          "type": "array"
        },
        "transportSource": {
          "description": "When set, every declared transport must exist as a real channel in this source.",
          "oneOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "transports": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "trustPlane": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "audience",
        "consumers",
        "deadlineMs",
        "failureOwner",
        "id",
        "lifecycle",
        "operations",
        "protocol",
        "provider",
        "scope",
        "sourceStatus",
        "sources",
        "transportSource",
        "transports",
        "trustPlane",
        "version"
      ],
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "effect": {
            "const": true
          }
        }
      },
      "properties": {
        "effect": {
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "receipt": {
          "description": "Required whenever effect is true; null otherwise.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "$ref": "#/$defs/receiptKind"
                },
                "ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "recoveryOperation": {
                  "description": "Required only for retryClass=reconcile_receipt; names a non-effect operation in the same boundary that reads the authoritative result.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryClass": {
          "$ref": "#/$defs/retryClass"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "siteBinding": {
          "$ref": "#/$defs/siteBinding"
        },
        "transport": {
          "description": "Must appear in the owning boundary's transports list. One operation, one transport, forever.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "transport",
        "effect",
        "retryClass",
        "scope",
        "siteBinding",
        "receipt"
      ],
      "then": {
        "properties": {
          "receipt": {
            "type": "object"
          }
        }
      },
      "type": "object"
    },
    "party": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "description": "An exact root id from config/architecture/index-roots.yaml with kind=boundary, nested inside repository.",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "boundary"
      ],
      "type": "object"
    },
    "receiptKind": {
      "description": "How a caller re-reads the authoritative outcome of an effectful operation.",
      "enum": [
        "command-receipt",
        "durable-event",
        "http-receipt-body",
        "idempotency-key",
        "state-read"
      ]
    },
    "retryClass": {
      "description": "Mirrors kokoro.common.v1.RetryClass minus its proto3 zero sentinel. The gate re-derives this list from the proto and fails on drift.",
      "enum": [
        "after_delay",
        "never",
        "reconcile_receipt",
        "same_identity"
      ]
    },
    "scope": {
      "description": "site = Platform business isolation. platform = cross-Site platform plane. namespace = GA runtime isolation.",
      "enum": [
        "namespace",
        "platform",
        "site"
      ]
    },
    "siteBinding": {
      "description": "How the operation binds its Site. request-field = an owner-verified request field. workload-binding = derived from authenticated deployment identity, never browser input. context-header = migration debt. not-applicable = no Site isolation.",
      "enum": [
        "context-header",
        "not-applicable",
        "request-field",
        "workload-binding"
      ]
    },
    "sourceKind": {
      "enum": [
        "openapi",
        "proto",
        "spec-yaml"
      ]
    },
    "source": {
      "additionalProperties": false,
      "description": "A machine-readable contract source. The set of operations it declares must equal the registered operation set exactly, in both directions.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "select": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "service": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "service"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "case": {
                  "enum": [
                    "snake"
                  ]
                },
                "field": {
                  "minLength": 1,
                  "type": "string"
                },
                "match": {
                  "minLength": 1,
                  "type": "string"
                },
                "member": {
                  "enum": [
                    "field",
                    "mapping-key",
                    "scalar"
                  ]
                },
                "section": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "section",
                "member"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "member": {
                  "const": "operation-id"
                }
              },
              "required": [
                "member"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "select"
      ],
      "type": "object"
    },
    "sourceStatus": {
      "description": "Whether this repository holds a contract source for the boundary. machine-readable = sources is non-empty and the gate enforces exact two-way parity between declared operations and that source. declared-only = no contract source exists here yet, so no orphan check can run; the gate counts these boundaries on every successful run so the blind spot stays visible instead of passing as covered.",
      "enum": [
        "declared-only",
        "machine-readable"
      ]
    }
  },
  "$id": "https://kokoro.local/schemas/boundary-registry-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Wave T0 contract foundation, stored as JSON-compatible YAML at contract/registry/boundaries.yaml. Every cross-repository boundary declares its owner, callers, audience, protocol, deadline, retry class, receipt and failure owner, and freezes exactly one transport per operation. scripts/contract/check-boundary-registry.mjs enforces this schema plus the source-parity, transport-freeze and isolation-axis rules, and fails if the enums below drift from contract/proto/kokoro/common/v1/error.proto.",
  "properties": {
    "boundaries": {
      "items": {
        "$ref": "#/$defs/boundary"
      },
      "minItems": 1,
      "type": "array"
    },
    "owners": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "owners",
    "boundaries"
  ],
  "title": "Kokoro cross-repository boundary registry",
  "type": "object"
}
