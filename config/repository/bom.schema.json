{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoro.internal/schemas/repository-bom.schema.json",
  "title": "Kokoro Root repository Bill of Materials",
  "description": "Versioned record of one atomic Root pin promotion. Generated by scripts/repository/generate-bom.mjs; never references the commit that contains it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contracts",
    "contractsDigest",
    "evidence",
    "evidenceDigest",
    "generatorVersion",
    "manifestDigest",
    "matrixDigest",
    "promotionCommit",
    "repositories",
    "repositoryTopology",
    "runtimeGate",
    "schemaVersion"
  ],
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "description": "Length-framed SHA-256 hex digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryId": {
      "enum": ["kokoro-agent", "kokoro-platform", "kokoro-session", "kokoro-web"]
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": 1 },
    "repositoryTopology": { "const": "federated-submodules-v1" },
    "promotionCommit": {
      "description": "Root commit that atomically promoted the four gitlinks. Must be HEAD or an ancestor of HEAD at generation time.",
      "$ref": "#/$defs/commitSha"
    },
    "repositories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "path", "pin", "protocols", "recoverableRef"],
        "properties": {
          "id": { "$ref": "#/$defs/repositoryId" },
          "path": { "$ref": "#/$defs/repositoryId" },
          "origin": {
            "type": "string",
            "pattern": "^https://github\\.com/LordFoxFairy/[A-Za-z0-9._-]+\\.git$"
          },
          "pin": { "$ref": "#/$defs/commitSha" },
          "recoverableRef": {
            "description": "Independent annotated tag for this repository only. Never shared between repositories.",
            "type": "string",
            "pattern": "^refs/tags/[A-Za-z0-9._/-]+$"
          },
          "protocols": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "version"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "role": { "enum": ["consumer", "provider"] },
                "version": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumers", "id", "providers", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "providers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repositoryId" }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repositoryId" }
          },
          "artifactDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "contractsDigest": { "$ref": "#/$defs/digest" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "path"],
        "properties": {
          "path": {
            "description": "Repository-relative path of a committed evidence document.",
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "matrixDigest": { "$ref": "#/$defs/digest" },
    "runtimeGate": {
      "description": "Binding to the single runtime compatibility gate that certified this exact combination.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combinationDigest",
        "combinationId",
        "evidenceDigest",
        "outcome",
        "treeMode"
      ],
      "properties": {
        "combinationId": { "type": "string", "minLength": 1 },
        "combinationDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "outcome": { "const": "pass" },
        "treeMode": { "enum": ["head", "index"] }
      }
    }
  }
}
