# Root meta-repository input. Copy to .env; .env is ignored and must never be committed.

# GitHub repository bootstrap. gh auth is preferred; GH_TOKEN is optional.
KOKORO_GITHUB_HOST=github.com
KOKORO_GITHUB_OWNER=LordFoxFairy
KOKORO_GITHUB_VISIBILITY=private
KOKORO_GITHUB_DEFAULT_BRANCH=main
GH_TOKEN=

# Local independent-repository location. An absolute path is required in .env.
KOKORO_REPOSITORY_PARENT=/absolute/path/to/thefoxfairy

# Shared local infrastructure used only by bootstrap to provision child-owned configuration.
KOKORO_LOCAL_POSTGRES_ADMIN_URL=postgresql://localhost/postgres
KOKORO_LOCAL_REDIS_URL=redis://127.0.0.1:6379/0

# IAM-owned external acceptance configuration.
KOKORO_IAM_SMTP_URL=
KOKORO_IAM_E2E_EMAIL=user@example.com

# Agent-owned external acceptance configuration.
KOKORO_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
KOKORO_AGENT_OPENAI_API_KEY=
KOKORO_AGENT_E2E_MODEL=

# Payment-owned Stripe test configuration.
KOKORO_PAYMENT_STRIPE_SECRET_KEY=
KOKORO_PAYMENT_STRIPE_PUBLISHABLE_KEY=
KOKORO_PAYMENT_STRIPE_WEBHOOK_SECRET=

# Storage-owned S3 configuration. Blank endpoint lets Storage provision local MinIO.
KOKORO_STORAGE_S3_ENDPOINT=
KOKORO_STORAGE_S3_ACCESS_KEY=
KOKORO_STORAGE_S3_SECRET_KEY=
KOKORO_STORAGE_S3_BUCKET=kokoro-e2e
