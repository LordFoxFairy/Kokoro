# 自托管 langfuse（观测栈）配置模板。用法：cp .env.local.example .env.local 并填值（.env.local 不入库）。
#
# 方案 A：langfuse 复用 Kokoro 基建的 redis + minio，自留 postgres + clickhouse。
# 前置：先起基建层（建命名网络 + redis/minio），并在基建 minio 建好 bucket（见 docker-compose.yml 顶部注释）。

# 接哪个环境的基建网络（须与该环境基建的 KOKORO_NETWORK 一致）。
KOKORO_NETWORK=kokoro-net

# ---- 复用基建 minio（S3）：填基建 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD ----
LANGFUSE_S3_ENDPOINT=http://minio:9100
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_ACCESS_KEY_ID=kokoro
LANGFUSE_S3_SECRET_ACCESS_KEY=CHANGE_ME

# ---- 复用基建 redis：逻辑库 db 1（产品用 db 0）；无口令 ----
REDIS_CONNECTION_STRING=redis://redis:6379/1

# ---- langfuse 自身安全密钥（务必改）----
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=CHANGE_ME
# langfuse 专属引擎密码（随本 stack，可改）。
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# ---- INIT（首启自动建组织/项目/用户）----
NEXTAUTH_URL=http://localhost:3310
LANGFUSE_INIT_ORG_ID=kokoro
LANGFUSE_INIT_ORG_NAME=Kokoro
LANGFUSE_INIT_PROJECT_ID=kokoro-local
LANGFUSE_INIT_PROJECT_NAME=kokoro-local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_NAME=kokoro-dev
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
