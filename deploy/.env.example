# Latest-only single-host release template. Copy to deploy/.env.prod, replace every CHANGE_ME,
# provision the PostgreSQL database/roles, and populate deploy/secrets/<process>/ as documented in
# deploy/README.md. Kubernetes uses workload-specific Secrets instead of distributing this file.

NODE_ENV=production
KOKORO_NETWORK=kokoro-net
KOKORO_INFRA_ENVIRONMENT_SCOPE=production
KOKORO_INFRA_SCOPE=kokoro-infra_kokoro
KOKORO_INFRA_RESTART_POLICY=unless-stopped

# Canonical infrastructure
KOKORO_POSTGRES_PORT=5433
KOKORO_REDIS_PORT=6379
KOKORO_MONGO_PORT=27017
KOKORO_MINIO_PORT=9100
KOKORO_MINIO_CONSOLE_PORT=9101
KOKORO_LITELLM_PORT=4000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_admin
POSTGRES_DB=postgres
KOKORO_POSTGRES_AUTH_MARKER=postgres-auth-v1
MINIO_ROOT_USER=kokoro
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
KOKORO_MINIO_AUTH_MARKER=minio-auth-v1
LITELLM_MASTER_KEY=CHANGE_ME_litellm
KOKORO_LITELLM_CONFIG=./config/infra/litellm.config.example.yaml
OPENAI_API_KEY=CHANGE_ME_or_remove
ANTHROPIC_API_KEY=CHANGE_ME_or_remove
OPENAI_COMPAT_BASE_URL=https://CHANGE_ME.example/v1
OPENAI_COMPAT_API_KEY=CHANGE_ME_or_remove

# Promoted artifacts and localhost-only operator ports. Site is built/promoted by its own project.
KOKORO_PLATFORM_IMAGE=kokoro-platform:latest
KOKORO_SESSION_IMAGE=kokoro-session:latest
KOKORO_AGENT_IMAGE=kokoro-agent:latest
# Required: promote the image produced by one generated Site project; there is no Root fallback.
# KOKORO_SITE_IMAGE=registry.example/kokoro/product-site@sha256:<64-lowercase-hex>
KOKORO_SITE_HOST_PORT=3000
KOKORO_SESSION_HOST_PORT=3900
KOKORO_SESSION_OWNER_AUTHORITY_HOST_PORT=3901
KOKORO_AGENT_EVIDENCE_HOST_PORT=8443
KOKORO_SECRETS_DIR=./deploy/secrets
KOKORO_STORAGE_FILE=./deploy/storage.yaml
# Fresh install only: keep this commented during ordinary releases. Export an absolute host path
# before deploy/provision.sh to install 2-16 initial governors and permanently seal bootstrap.
# KOKORO_ADMIN_AUTHORITY_BOOTSTRAP_FILE=/absolute/protected/admin-authority-bootstrap.json

# Platform PostgreSQL authority. These eight LOGIN roles and kokoro_platform database must exist
# before platform-migrator runs; each URL uses only its named role.
PLATFORM_DATABASE_EXPECTED_DATABASE=kokoro_platform
PLATFORM_DATABASE_MIGRATOR_ROLE=platform_migrator
PLATFORM_DATABASE_API_ROLE=platform_api
PLATFORM_DATABASE_ADMISSION_ROLE=platform_admission
PLATFORM_DATABASE_AUTHORIZATION_ROLE=platform_authorization
PLATFORM_DATABASE_ASSET_DATA_PLANE_ROLE=platform_asset_data_plane
PLATFORM_DATABASE_MODEL_GATEWAY_ROLE=platform_model_gateway
PLATFORM_DATABASE_WORKER_ROLE=platform_worker
PLATFORM_DATABASE_ADMIN_ROLE=platform_admin
DATABASE_URL_PLATFORM_MIGRATOR=postgresql://platform_migrator:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_API=postgresql://platform_api:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_ADMISSION=postgresql://platform_admission:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_AUTHORIZATION=postgresql://platform_authorization:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_ASSET_DATA_PLANE=postgresql://platform_asset_data_plane:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_MODEL_GATEWAY=postgresql://platform_model_gateway:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_WORKER=postgresql://platform_worker:CHANGE_ME@postgres:5432/kokoro_platform
DATABASE_URL_PLATFORM_ADMIN=postgresql://platform_admin:CHANGE_ME@postgres:5432/kokoro_platform

# Platform public API (files live in deploy/secrets/platform-api/).
PLATFORM_PRODUCT_WORKLOAD_REGISTRY_FILE=/run/secrets/kokoro/product-workloads.json
PLATFORM_SESSION_ACCESS_KEY_RING_FILE=/run/secrets/kokoro/session-access-keys.json
PLATFORM_AUTHORIZATION_EVENT_KEY_RING_FILE=/run/secrets/kokoro/authorization-event-keys.json
PLATFORM_COMMERCE_REDEMPTION_KEY_RING_FILE=/run/secrets/kokoro/commerce-redemption-keys.json
PLATFORM_ASSET_UPLOAD_POLICY_REGISTRY_FILE=/run/secrets/kokoro/asset-upload-policies.json
PLATFORM_ASSET_UPLOAD_CAPABILITY_KEY_RING_FILE=/run/secrets/kokoro/asset-upload-capability-keys.json
PLATFORM_IDENTITY_PASSWORD_PEPPER_RING_FILE=/run/secrets/kokoro/identity-password-peppers.json
PLATFORM_IDENTITY_VERIFICATION_DIGEST_KEY_FILE=/run/secrets/kokoro/identity-verification.key
PLATFORM_IDENTITY_SESSION_DIGEST_KEY_FILE=/run/secrets/kokoro/identity-session.key
PLATFORM_IDENTITY_REFRESH_DIGEST_KEY_FILE=/run/secrets/kokoro/identity-refresh.key
PLATFORM_IDENTITY_REAUTH_DIGEST_KEY_FILE=/run/secrets/kokoro/identity-reauth.key
PLATFORM_IDENTITY_AUDIT_DIGEST_KEY_FILE=/run/secrets/kokoro/identity-audit.key
PLATFORM_IDENTITY_DELIVERY_KEY_FILE=/run/secrets/kokoro/identity-delivery.key
PLATFORM_IDENTITY_TOTP_KEY_RING_FILE=/run/secrets/kokoro/identity-totp-keys.json
PLATFORM_PUBLIC_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_PUBLIC_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
PLATFORM_PUBLIC_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt

# Platform Admission and owner RPCs (files live in deploy/secrets/platform-admission/).
PLATFORM_ADMISSION_ENVIRONMENT=production
PLATFORM_ADMISSION_REGION=us-east-1
PLATFORM_ADMISSION_GA_DISPATCH_AUDIENCE=kokoro-agent
PLATFORM_ADMISSION_MTLS_PEERS_FILE=/run/secrets/kokoro/peers.json
PLATFORM_ADMISSION_HPKE_PUBLIC_KEY_RING_FILE=/run/secrets/kokoro/run-request-hpke-public.json
PLATFORM_CAPABILITY_PROJECTION_HUB_PUBLIC_KEY_RING_FILE=/run/secrets/kokoro/hub-capability-public.json
PLATFORM_ASSET_ELIGIBILITY_SESSION_CALLER_SAN_URI=spiffe://kokoro/session
PLATFORM_CAPABILITY_PROJECTION_HUB_CALLER_SAN_URI=spiffe://kokoro/hub/runtime
PLATFORM_ADMISSION_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_ADMISSION_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
PLATFORM_ADMISSION_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt
PLATFORM_ADMISSION_OUTBOUND_TLS_CERT_FILE=/run/secrets/kokoro/client.crt
PLATFORM_ADMISSION_OUTBOUND_TLS_KEY_FILE=/run/secrets/kokoro/client.key
PLATFORM_ADMISSION_SESSION_CA_FILE=/run/secrets/kokoro/session-ca.crt
PLATFORM_ADMISSION_SESSION_BASE_URL=https://kokoro-session:3901
PLATFORM_ADMISSION_SESSION_SERVER_NAME=kokoro-session.internal
PLATFORM_ADMISSION_AGENT_CA_FILE=/run/secrets/kokoro/agent-ca.crt
PLATFORM_ADMISSION_AGENT_BASE_URL=https://kokoro-agent-evidence:8443
PLATFORM_ADMISSION_AGENT_SERVER_NAME=kokoro-agent-evidence.internal

# Session authorization feed (files live in deploy/secrets/platform-authorization/).
PLATFORM_AUTHORIZATION_EVENT_VERIFICATION_KEY_SET_FILE=/run/secrets/kokoro/authorization-event-public.json
PLATFORM_SESSION_ACCESS_VERIFICATION_KEY_SET_FILE=/run/secrets/kokoro/session-access-public.json
PLATFORM_AUTHORIZATION_MTLS_PEERS_FILE=/run/secrets/kokoro/peers.json
PLATFORM_AUTHORIZATION_CURSOR_SECRET_FILE=/run/secrets/kokoro/cursor.key
PLATFORM_AUTHORIZATION_SESSION_SPIFFE_ID=spiffe://kokoro/session
PLATFORM_AUTHORIZATION_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_AUTHORIZATION_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
PLATFORM_AUTHORIZATION_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt

# Asset data plane (files live in deploy/secrets/platform-asset-data-plane/).
PLATFORM_ASSET_DATA_PLANE_AUDIENCE=kokoro-site
PLATFORM_ASSET_STORAGE_ROUTE_FILE=/run/secrets/kokoro/storage-routes.json
PLATFORM_ASSET_DATA_PLANE_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_ASSET_DATA_PLANE_TLS_CERT_FILE=/run/secrets/kokoro/server.crt

# Model gateway (files live in deploy/secrets/platform-model-gateway/).
PLATFORM_MODEL_GATEWAY_MTLS_PEERS_FILE=/run/secrets/kokoro/peers.json
PLATFORM_MODEL_GATEWAY_RESPONSE_KEY_RING_FILE=/run/secrets/kokoro/response-keys.json
PLATFORM_MODEL_GATEWAY_LITELLM_API_KEY_FILE=/run/secrets/kokoro/litellm-api.key
PLATFORM_MODEL_GATEWAY_LITELLM_ENDPOINT=http://litellm:4000/v1/chat/completions
PLATFORM_MODEL_GATEWAY_AGENT_CALLER_SAN_URI=spiffe://kokoro/agent/worker
PLATFORM_MODEL_GATEWAY_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_MODEL_GATEWAY_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
PLATFORM_MODEL_GATEWAY_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt

# Platform Admin and Worker.
PLATFORM_ADMIN_MTLS_PEERS_FILE=/run/secrets/kokoro/peers.json
PLATFORM_ADMIN_OIDC_CLIENTS_FILE=/run/secrets/kokoro/oidc-clients.json
PLATFORM_ADMIN_OIDC_TRANSACTION_KEY_FILE=/run/secrets/kokoro/oidc-transaction.key
PLATFORM_ADMIN_CURSOR_KEY_FILE=/run/secrets/kokoro/cursor.key
PLATFORM_ADMIN_JOSE_KEY_RING_FILE=/run/secrets/kokoro/session-jose-keys.json
PLATFORM_SITE_RELEASE_CERTIFICATION_KEYS_FILE=/run/secrets/kokoro/site-release-certification-keys.json
PLATFORM_ADMIN_TLS_KEY_FILE=/run/secrets/kokoro/server.key
PLATFORM_ADMIN_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
PLATFORM_ADMIN_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt
PLATFORM_ENVIRONMENT=production
PLATFORM_REGION=us-east-1
PLATFORM_SITE_PROVIDER_REGISTRY_FILE=/run/secrets/kokoro/site-providers.json
PLATFORM_SITE_WORKER_ID=platform-worker-1

# Hub HTTP management and runtime Connect are separate processes over the same Mongo/S3 authority.
KOKORO_HUB_MONGO_URL=mongodb://mongo:27017/?replicaSet=kokoro-rs
KOKORO_HUB_MONGO_DB=kokoro_hub
KOKORO_HUB_SECRET_MASTER_KEY=CHANGE_ME_32_byte_base64
KOKORO_HUB_MCP_MUTATION=on
KOKORO_WORKSPACE_CONFIG=/app/storage.yaml
KOKORO_HUB_CONNECT_TLS_KEY_FILE=/run/secrets/kokoro/server.key
KOKORO_HUB_CONNECT_TLS_CERT_FILE=/run/secrets/kokoro/server.crt
KOKORO_HUB_CONNECT_TLS_CLIENT_CA_FILE=/run/secrets/kokoro/client-ca.crt
KOKORO_HUB_CONNECT_MTLS_PEERS_FILE=/run/secrets/kokoro/peers.json
KOKORO_HUB_CAPABILITY_SIGNING_KEY_FILE=/run/secrets/kokoro/capability-signing.key
KOKORO_HUB_CAPABILITY_SIGNING_KEY_REF=hub-capability-2026-01
KOKORO_HUB_CATALOG_PLATFORM_CALLER_SAN_URI=spiffe://kokoro/platform/admission
KOKORO_HUB_RUNTIME_AGENT_CALLER_SAN_URI=spiffe://kokoro/agent/worker
KOKORO_HUB_PLATFORM_PROJECTION_BASE_URL=https://platform-admission:4244
KOKORO_HUB_PLATFORM_PROJECTION_SERVER_NAME=platform-admission.internal
KOKORO_HUB_PLATFORM_PROJECTION_CLIENT_CERT_FILE=/run/secrets/kokoro/platform-client.crt
KOKORO_HUB_PLATFORM_PROJECTION_CLIENT_KEY_FILE=/run/secrets/kokoro/platform-client.key
KOKORO_HUB_PLATFORM_PROJECTION_SERVER_CA_FILE=/run/secrets/kokoro/platform-ca.crt

# Session Browser v3 (copy the exact child template and place files under deploy/secrets/session/).
KOKORO_REDIS_URL=redis://redis:6379/0
DATABASE_URL_SESSION_API=postgresql://session_api:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_GA_PROJECTOR=postgresql://session_ga_projector:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_ADMISSION_WORKER=postgresql://session_admission_worker:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_DISPATCH_WORKER=postgresql://session_dispatch_worker:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_CONTROL_WORKER=postgresql://session_control_worker:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_AUTHORIZATION_CONSUMER=postgresql://session_authorization_consumer:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_DISPATCH_OWNER_AUTHORITY=postgresql://session_dispatch_owner_authority:CHANGE_ME@postgres:5432/kokoro_session
DATABASE_URL_SESSION_ADMISSION_OWNER_AUTHORITY=postgresql://session_admission_owner_authority:CHANGE_ME@postgres:5432/kokoro_session
KOKORO_SESSION_API_DATABASE_ROLE=session_api
KOKORO_SESSION_GA_PROJECTOR_DATABASE_ROLE=session_ga_projector
KOKORO_SESSION_ADMISSION_WORKER_DATABASE_ROLE=session_admission_worker
KOKORO_SESSION_DISPATCH_WORKER_DATABASE_ROLE=session_dispatch_worker
KOKORO_SESSION_CONTROL_WORKER_DATABASE_ROLE=session_control_worker
KOKORO_SESSION_AUTHORIZATION_CONSUMER_DATABASE_ROLE=session_authorization_consumer
KOKORO_SESSION_DISPATCH_OWNER_AUTHORITY_DATABASE_ROLE=session_dispatch_owner_authority
KOKORO_SESSION_ADMISSION_OWNER_AUTHORITY_DATABASE_ROLE=session_admission_owner_authority
KOKORO_SESSION_MIGRATOR_DATABASE_ROLES=session_migrator
KOKORO_SESSION_CURSOR_KEY_REVISION=cursor-key-2026-01
KOKORO_SESSION_CURSOR_SECRET_BASE64URL=CHANGE_ME_base64url_32_bytes_minimum___________
KOKORO_PLATFORM_AUTHORIZATION_URL=https://platform-authorization:4143
KOKORO_PLATFORM_AUTHORIZATION_SERVER_NAME=platform-authorization.internal
KOKORO_PLATFORM_AUTHORIZATION_CLIENT_CERT_FILE=/run/secrets/kokoro/platform-client.crt
KOKORO_PLATFORM_AUTHORIZATION_CLIENT_KEY_FILE=/run/secrets/kokoro/platform-client.key
KOKORO_PLATFORM_AUTHORIZATION_CA_FILE=/run/secrets/kokoro/platform-ca.crt
KOKORO_PLATFORM_AUTHORIZATION_ISSUER=https://identity.CHANGE_ME.example
KOKORO_PLATFORM_ADMISSION_URL=https://platform-admission:4244
KOKORO_PLATFORM_ADMISSION_SERVER_NAME=platform-admission.internal
KOKORO_PLATFORM_ADMISSION_CLIENT_CERT_FILE=/run/secrets/kokoro/platform-client.crt
KOKORO_PLATFORM_ADMISSION_CLIENT_KEY_FILE=/run/secrets/kokoro/platform-client.key
KOKORO_PLATFORM_ADMISSION_CA_FILE=/run/secrets/kokoro/platform-ca.crt
KOKORO_PLATFORM_ASSET_ELIGIBILITY_URL=https://platform-admission:4244
KOKORO_PLATFORM_ASSET_ELIGIBILITY_SERVER_NAME=platform-admission.internal
KOKORO_SESSION_ADMISSION_COMMAND_KEY_RING_FILE=/run/secrets/kokoro/admission-command-keys.json
KOKORO_AGENT_EVIDENCE_URL=https://kokoro-agent-evidence:8443
KOKORO_AGENT_EVIDENCE_SERVER_NAME=kokoro-agent-evidence.internal
KOKORO_AGENT_EVIDENCE_CLIENT_CERT_FILE=/run/secrets/kokoro/agent-client.crt
KOKORO_AGENT_EVIDENCE_CLIENT_KEY_FILE=/run/secrets/kokoro/agent-client.key
KOKORO_AGENT_EVIDENCE_CA_FILE=/run/secrets/kokoro/agent-ca.crt
KOKORO_SESSION_SITE_BFF_WORKLOAD_REGISTRY_FILE=/run/secrets/kokoro/site-bff-workloads.json
KOKORO_SESSION_BROWSER_SERVER_CERT_FILE=/run/secrets/kokoro/browser-server.crt
KOKORO_SESSION_BROWSER_SERVER_KEY_FILE=/run/secrets/kokoro/browser-server.key
KOKORO_SESSION_BROWSER_CA_FILE=/run/secrets/kokoro/site-bff-ca.crt
KOKORO_SESSION_OWNER_AUTHORITY_SERVER_CERT_FILE=/run/secrets/kokoro/owner-server.crt
KOKORO_SESSION_OWNER_AUTHORITY_SERVER_KEY_FILE=/run/secrets/kokoro/owner-server.key
KOKORO_SESSION_OWNER_AUTHORITY_CA_FILE=/run/secrets/kokoro/platform-ca.crt
KOKORO_SESSION_OWNER_AUTHORITY_PEERS_FILE=/run/secrets/kokoro/owner-peers.json
KOKORO_SESSION_RUN_REQUEST_HPKE_PRIVATE_KEY_RING_FILE=/run/secrets/kokoro/run-request-hpke-private.json
KOKORO_SESSION_RUN_REQUEST_HPKE_AUDIENCE=session.dispatch

# Agent worker/evidence. Each process receives its own env/file directory in production.
KOKORO_MONGO_URL=mongodb://mongo:27017/?replicaSet=kokoro-rs
KOKORO_MONGO_DB=kokoro
KOKORO_MODEL_GATEWAY_URL=https://platform-model-gateway:4247
KOKORO_MODEL_GATEWAY_SERVER_NAME=platform-model-gateway.internal
KOKORO_MODEL_GATEWAY_CERT_FILE=/run/secrets/kokoro/model-gateway-client.crt
KOKORO_MODEL_GATEWAY_KEY_FILE=/run/secrets/kokoro/model-gateway-client.key
KOKORO_MODEL_GATEWAY_CA_FILE=/run/secrets/kokoro/model-gateway-ca.crt
KOKORO_HUB_RPC_URL=https://kokoro-hub-runtime:4252
KOKORO_HUB_RPC_SERVER_NAME=kokoro-hub-runtime.internal
KOKORO_HUB_RPC_CERT_FILE=/run/secrets/kokoro/hub-client.crt
KOKORO_HUB_RPC_KEY_FILE=/run/secrets/kokoro/hub-client.key
KOKORO_HUB_RPC_CA_FILE=/run/secrets/kokoro/hub-ca.crt
KOKORO_DEFAULT_BACKEND=local_shell
KOKORO_AGENT_LOCAL_SHELL_ROOT=/data/workspace/workspace
KOKORO_AGENT_EVIDENCE_TLS_CERT=/run/secrets/kokoro/server.crt
KOKORO_AGENT_EVIDENCE_TLS_KEY=/run/secrets/kokoro/server.key
KOKORO_AGENT_EVIDENCE_CALLER_CA_BUNDLE=/run/secrets/kokoro/caller-ca.crt
KOKORO_AGENT_EVIDENCE_ALLOWED_CALLERS=kokoro-session,kokoro-platform

# Generated Site release. Values are release-specific and normally come from the Site repository.
AUTH_SECRET=CHANGE_ME_32_chars_minimum
AUTH_URL=https://CHANGE_ME.example
KOKORO_SITE_PUBLIC_ORIGIN=https://CHANGE_ME.example
KOKORO_SITE_RUNTIME_ENVIRONMENT=production
KOKORO_SITE_PROJECT_BINDING_REF=CHANGE_ME_binding
KOKORO_SITE_DEPLOYMENT_REF=CHANGE_ME_deployment
KOKORO_SITE_RELEASE_REF=CHANGE_ME_release
KOKORO_WEB_ARTIFACT_DIGEST=CHANGE_ME_sha256
KOKORO_PLATFORM_WORKLOAD_CREDENTIAL=CHANGE_ME_32_chars_minimum
KOKORO_SESSION_CONTRACT_REVISION=session-browser-v3
KOKORO_SITE_REGION=us-east-1
KOKORO_PRODUCT_AUDIENCE=kokoro-site
KOKORO_SITE_RUNTIME_PLATFORM_ORIGIN=https://platform-api:4100
KOKORO_SITE_RUNTIME_SESSION_ORIGIN=https://kokoro-session:3900
KOKORO_PLATFORM_CSRF_TOKEN=CHANGE_ME_32_chars_minimum
KOKORO_BROWSER_CSRF_SECRET=CHANGE_ME_32_chars_minimum
KOKORO_SITE_RUNTIME_MTLS_CERT_FILE=/run/secrets/kokoro/site-client.crt
KOKORO_SITE_RUNTIME_MTLS_KEY_FILE=/run/secrets/kokoro/site-client.key
KOKORO_SITE_RUNTIME_MTLS_CA_FILE=/run/secrets/kokoro/internal-ca.crt
KOKORO_SITE_REGISTRATION_LEGAL_DOCUMENTS=[]
