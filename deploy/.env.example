# Kokoro 单机全栈生产环境变量模板。
# 用法：cp deploy/.env.example deploy/.env，把所有 CHANGE_ME 换成真值，再 docker compose -f docker-compose.prod.yml up -d --build。
# 绝不提交 deploy/.env（根 .gitignore 已忽略 .env）。所有值仅示意，生产必须换。

# ============ 基础设施 ============
# MySQL：password 需与下方 DATABASE_URL_* 里的密码一致。
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_DATABASE=kokoro
MYSQL_USER=kokoro
MYSQL_PASSWORD=CHANGE_ME_mysql_user
# MinIO 对象存储（预留：hub 包体/产物可切 S3；当前 storage.prod.yaml 用共享本地卷）。
MINIO_ROOT_USER=kokoro
MINIO_ROOT_PASSWORD=CHANGE_ME_minio

# ============ 各服务数据库（同一 MySQL 实例，密码同 MYSQL_ROOT_PASSWORD）============
DATABASE_URL_SITE=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro
DATABASE_URL_USER=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro
DATABASE_URL_MODEL=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro
DATABASE_URL_CREDIT=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro
DATABASE_URL_PAYMENT=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro
DATABASE_URL_ADMIN=mysql://root:CHANGE_ME_mysql_root@mysql:3306/kokoro

# ============ 端口 ============
KOKORO_SITE_PORT=4201
KOKORO_USER_PORT=4211
KOKORO_MODEL_PORT=4221
KOKORO_CREDIT_PORT=4231
KOKORO_PAYMENT_PORT=4241
KOKORO_HUB_PORT=4251
KOKORO_ADMIN_PORT=4290
KOKORO_SESSION_PORT=3900
PORT=3000

# ============ 服务间地址（compose 服务名 DNS，容器内互访）============
KOKORO_SITE_BASE_URL=http://kokoro-site:4201
KOKORO_USER_BASE_URL=http://kokoro-user:4211
KOKORO_MODEL_BASE_URL=http://kokoro-model:4221
KOKORO_CREDIT_BASE_URL=http://kokoro-credit:4231
KOKORO_PAYMENT_BASE_URL=http://kokoro-payment:4241
KOKORO_HUB_BASE_URL=http://kokoro-hub:4251
KOKORO_SESSION_BASE_URL=http://kokoro-session:3900
KOKORO_REDIS_URL=redis://redis:6379/0

# ============ 内部服务间调用凭据（per-caller，生产 fail-fast 必配；各生成独立强随机）============
# 生成：openssl rand -hex 32
KOKORO_INTERNAL_SECRET_SESSION=CHANGE_ME_secret_session
KOKORO_INTERNAL_SECRET_WEB_BFF=CHANGE_ME_secret_web_bff
KOKORO_INTERNAL_SECRET_ADMIN=CHANGE_ME_secret_admin
KOKORO_INTERNAL_SECRET_HUB=CHANGE_ME_secret_hub
KOKORO_INTERNAL_SECRET_PAYMENT=CHANGE_ME_secret_payment
KOKORO_INTERNAL_SECRET_CREDIT=CHANGE_ME_secret_credit

# ============ 认证（生产 RS256/JWKS）============
# user 以 RS256 私钥签发（PEM/PKCS8，单行内用 \n 转义或用 env 文件多行）。
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out user_jwt.pem
KOKORO_USER_JWT_PRIVATE_KEY=CHANGE_ME_rsa_private_key_pem
KOKORO_AUTH_JWT_ISSUER=kokoro-user
# session 生产走 jwks，从 user 的 JWKS 端点取公钥验签。
KOKORO_AUTH_MODE=jwks
KOKORO_AUTH_JWKS_URL=http://kokoro-user:4211/.well-known/jwks.json
# magic-link 投递：先 log（不外发，登录链看服务日志）；接 SMTP 后改 smtp（见 SMTP 段）。
KOKORO_AUTH_MAGIC_DELIVERY=log

# ============ session ============
KOKORO_MESSAGE_STORE_MONGO_URL=mongodb://mongo:27017
KOKORO_MESSAGE_STORE_MONGO_DB=kokoro
KOKORO_WORKSPACE_CONFIG=/app/storage.yaml
KOKORO_WORKSPACE_ROOT=/data/workspace/workspace
# 生产计费：enforce（余额不足拒 run）。测试期可临时 shadow。
KOKORO_BILLING_MODE=enforce
# 站点 id：与 seed 的站点一致（site-<key>）。
KOKORO_SITE_ID=site-CHANGE_ME
# 浏览器可见的 web 源（真实域名，用于 session CORS / cookie 域）。
KOKORO_WEB_ORIGIN=https://CHANGE_ME.example.com

# ============ hub ============
KOKORO_HUB_MONGO_URL=mongodb://mongo:27017
KOKORO_HUB_MONGO_DB=kokoro_hub
# MCP 自服务注册门：on 允许运营注册 MCP；关可设 off。
KOKORO_HUB_MCP_MUTATION=on

# ============ agent ============
KOKORO_MONGO_URL=mongodb://mongo:27017
KOKORO_MONGO_DB=kokoro
KOKORO_AGENT_LOCAL_SHELL_ROOT=/data/workspace/workspace
# 生产 MCP egress：strict（拒私网/环回，防 SSRF）。dev 才用 off。
KOKORO_MCP_EGRESS_MODE=strict
# 模型后端：1=离线假模型（先把部署跑通）；接真模型后置 0 并配 litellm 下方凭据。
KOKORO_LOCAL_FAKE_MODEL=1
KOKORO_LITELLM_BASE_URL=http://litellm:4000/v1
KOKORO_LITELLM_API_KEY=CHANGE_ME_litellm_key

# ============ web（服务端 env，非 NEXT_PUBLIC，浏览器读不到）============
# 会话信封密钥（密封 cookie）：openssl rand -hex 32
KOKORO_WEB_SESSION_SECRET=CHANGE_ME_web_session_secret
# 支付 mock webhook secret（dev 模拟收银台用；接真网关后由真 provider 验签取代）。
KOKORO_PAYMENT_MOCK_WEBHOOK_SECRET=CHANGE_ME_mock_webhook

# ============ platform-admin 网关 ============
# 生产鉴权：oidc（配下方 OIDC）或 proxy（配 KOKORO_ADMIN_PROXY_SECRETS）。
# dev 档=固定 operator 无真鉴权，仅首次 bring-up 用，务必切走。
KOKORO_ADMIN_AUTH_MODE=dev
KOKORO_ADMIN_DEV_OPERATOR=admin@example.com
# 切 oidc 时配：
# KOKORO_ADMIN_AUTH_MODE=oidc
# KOKORO_ADMIN_OIDC_JWKS_URL=https://your-idp/.well-known/jwks.json
# KOKORO_ADMIN_OIDC_ISSUER=https://your-idp/
# KOKORO_ADMIN_OIDC_AUDIENCE=kokoro-admin

# ============ litellm 网关 ============
# 网关主密钥（= 上面 KOKORO_LITELLM_API_KEY）。
LITELLM_MASTER_KEY=CHANGE_ME_litellm_key
# 模型 provider 凭据（接真模型时配；归 kokoro-model 域，只经此 env 注入，绝不提交）。
# 例（GLM/OpenAI 兼容）：
# GLM_API_KEY=CHANGE_ME
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============ SMTP（magic-link 邮件；接入后把 KOKORO_AUTH_MAGIC_DELIVERY 改 smtp）============
# 见 kokoro-user 邮件实现（上线任务 #57）。
# KOKORO_SMTP_HOST=CHANGE_ME
# KOKORO_SMTP_PORT=587
# KOKORO_SMTP_USER=CHANGE_ME
# KOKORO_SMTP_PASSWORD=CHANGE_ME
# KOKORO_SMTP_FROM=noreply@example.com
