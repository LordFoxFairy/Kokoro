# Kokoro Phase 1 local/production baseline.
# Copy to deploy/.env.phase1.local or deploy/.env.phase1.prod; files with real values stay gitignored.
# The only stateful infrastructure is PostgreSQL + Redis.

KOKORO_NETWORK=kokoro-net
KOKORO_DOMAIN=dev.kokoro.localhost
KOKORO_POSTGRES_PORT=5432
KOKORO_REDIS_PORT=6379

POSTGRES_DB=kokoro
POSTGRES_USER=kokoro
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
KOKORO_AGENT_DATABASE_URL=postgresql://kokoro:CHANGE_ME_postgres_password@postgres:5432/kokoro
KOKORO_AGENT_DATABASE_SCHEMA=kokoro_agent
KOKORO_REDIS_URL=redis://redis:6379/10

# BFF is the Web-facing Chat/business layer. Phase 1 uses its deterministic mock adapter.
KOKORO_BFF_MODE=mock
KOKORO_BFF_SHARED_SECRET=CHANGE_ME_bff_shared_secret
KOKORO_INTERNAL_SECRET_WEB_BFF=CHANGE_ME_bff_shared_secret

# The Web container is intentionally preview-authenticated for this three-repo closure.
# Add the user/IAM service and production auth envelope before turning preview off.
NEXT_PUBLIC_SESSION_PREVIEW=1
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Optional model/provider values are injected into kokoro-agent only when a real run is enabled.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# KOKORO_AGENT_METRICS_PORT=9090
